{
  "name": "hoc-tu-vung-trung",
  "version": "2.0.0",
  "description": "App học từ vựng tiếng Trung có đăng nhập, lưu tiến độ theo tài khoản (bản deploy Vercel + Postgres)",
  "main": "api/index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node api/index.js",
    "dev": "node api/index.js",
    "test": "node test/fsrs.test.js",
    "test:vocab-merge": "node test/vocab-merge.test.js",
    "test:visibility-timer": "node test/visibility-timer.test.js",
    "test:vocab-identity": "node test/vocab-identity.integration.test.js",
    "test:book-defs": "node test/book-defs.integration.test.js",
    "test:distractor": "node test/heavy-distractor.test.js",
    "test:integration": "node test/fsrs.concurrency.integration.js",
    "test:optimizer": "node test/fsrs-optimizer.test.js",
    "test:optimizer:browser-assets": "node test/fsrs-optimizer.browser-asset-resolution.test.js",
    "test:optimizer:integration": "node test/fsrs-optimizer.integration.test.js",
    "test:optimizer:binding": "node test/fsrs-optimizer.binding.smoke.test.js",
    "test:optimizer:frontend": "node test/fsrs-optimizer-frontend.smoke.test.js",
    "test:skills": "node test/skills.test.js",
    "test:drill-notes": "node test/drill-notes.test.js",
    "test:orphans": "node test/orphans.test.js",
    "test:adaptive": "node test/question-engine.test.js && node test/adaptive-session.test.js && node test/review-render.smoke.test.js",
    "test:xss": "node test/xss-escaping.smoke.test.js",
    "test:auth-security": "node test/auth-security.test.js",
    "verify:fsrs6": "node scripts/verify-fsrs6.js",
    "verify:optimizer-binding": "node scripts/verify-optimizer-binding.js",
    "postinstall": "node scripts/verify-optimizer-binding.js; s=$?; node scripts/ensure-wasm-optimizer.js; exit $s",
    "migrate:fsrs": "node scripts/migrate-to-pure-fsrs.js",
    "migrate:vocab-identity": "node scripts/migrate-vocab-identity.js",
    "fix:current-lesson": "node scripts/fix-current-lesson-start.js",
    "test:answer-match": "node test/answer-match.test.js",
    "test:retention": "node test/retention-recommend.test.js",
    "test:v110-ui": "node test/v110-ui.smoke.test.js",
    "test:v110": "npm run test:answer-match && npm run test:retention && npm run test:v110-ui && npm run test:adaptive-v111 && npm run test:study-time && npm run test:v113",
    "test:adaptive-v111": "node test/adaptive-v111.test.js",
    "test:study-time": "node test/study-time.test.js",
    "test:v113": "node test/v113-evidence.test.js",
    "migrate:skill-evidence": "node scripts/migrate-skill-evidence.js"
  },
  "dependencies": {
    "express": "^4.19.2",
    "bcryptjs": "^2.4.3",
    "pg": "^8.12.0",
    "compression": "^1.7.4",
    "ts-fsrs": "5.4.1",
    "@vercel/functions": "^3.0.0",
    "@open-spaced-repetition/binding": "0.5.0"
  },
  "optionalDependencies": {
    "@open-spaced-repetition/binding-wasm32-wasi": "0.5.0"
  }
}
